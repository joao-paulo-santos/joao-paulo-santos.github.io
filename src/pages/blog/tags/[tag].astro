---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';

export async function getStaticPaths() {
  const slugify = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
  const posts = (await getCollection('blog')).filter(
    (p) => !p.data.draft || import.meta.env.DEV
  );

  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }

  return [...tagSet].map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Posts tagged ${tag}.`}
>
  <section class="mx-auto w-full max-w-3xl px-5 py-16">
    <a
      href="/blog/tags"
      class="text-sm transition hover:text-[color:var(--color-text)]"
      style="color: var(--color-muted)"
    >
      ← All tags
    </a>

    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
      <span style="color: var(--color-muted)">#</span>{tag}
    </h1>
    <p class="mt-2 text-sm" style="color: var(--color-muted)">
      {posts.length} post{posts.length === 1 ? '' : 's'}
    </p>

    <div class="mt-8">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</BaseLayout>
