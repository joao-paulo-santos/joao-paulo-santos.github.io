---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('pages', 'about');
if (!about) {
  throw new Error('About page content not found in src/content/pages/about.md');
}
const { Content } = await render(about);
const { title, description } = about.data;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto w-full max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
