---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_LINKS } from '../consts';
---

<BaseLayout
  title="Page Not Found"
  description="404, that page doesn't exist."
>
  <section
    class="mx-auto flex w-full max-w-3xl flex-col items-center px-5 py-24 text-center"
  >
    <p
      class="text-7xl font-bold tracking-tight"
      style="color: var(--color-muted)"
    >
      404
    </p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md" style="color: var(--color-muted)">
      The page you're looking for doesn't exist or has moved.
    </p>

    <a
      href="/"
      class="mt-6 inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] px-4 py-2 text-sm font-medium transition hover:bg-[color:var(--color-surface)]"
    >
      ← Back to home
    </a>

    <nav
      aria-label="Primary"
      class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-hover)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>
