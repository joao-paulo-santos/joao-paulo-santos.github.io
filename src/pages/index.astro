---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import {
  SITE_TITLE,
  SITE_ROLE,
  SITE_LOCATION,
  SITE_BIO,
  SOCIALS,
  CURRENTLY_WORKING_ON,
} from '../consts';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[color:var(--color-border)]">
    <!-- Soft accent glow in the corner -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(60% 80% at 85% 0%, var(--color-accent-soft), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto w-full max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:gap-12">
        <div class="flex-1 min-w-0">
          <p class="eyebrow mb-4">
            {SITE_ROLE} · {SITE_LOCATION}
          </p>
          <h1
            class="text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl"
          >
            {SITE_TITLE}
          </h1>
          <p
            class="mt-6 max-w-xl text-base leading-relaxed sm:text-lg"
            style="color: var(--color-muted)"
          >
            {SITE_BIO}
          </p>

          <ul class="mt-8 flex flex-wrap items-center gap-2">
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] px-3 py-1.5 text-sm font-medium text-[color:var(--color-text)] shadow-[var(--shadow-sm)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-border-strong)] hover:shadow-[var(--shadow)]"
                    aria-label={social.label}
                    rel="me noopener"
                    target="_blank"
                  >
                    <SocialIcon name={social.icon} class="h-4 w-4" />
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="shrink-0">
          <img
            src="/profilepic.jpeg"
            alt="João Paulo Santos"
            width="128"
            height="128"
            class="h-24 w-24 rounded-2xl object-cover shadow-[var(--shadow)] ring-1 ring-[color:var(--color-border-strong)] sm:h-32 sm:w-32"
          />
        </div>
      </div>

      <!-- Currently working on -->
      <div class="mt-12 border-t border-[color:var(--color-border)] pt-6">
        <p class="eyebrow mb-3">Currently</p>
        <ul class="space-y-2.5">
          {
            CURRENTLY_WORKING_ON.map((project) => (
              <li>
                <a
                  href={project.href}
                  class="group flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-sm transition"
                  rel="noopener"
                  target="_blank"
                >
                  <span class="inline-flex items-baseline gap-1 font-mono font-medium text-[color:var(--color-accent)] transition group-hover:text-[color:var(--color-accent-hover)]">
                    <span aria-hidden="true" class="text-[color:var(--color-subtle)]">→</span>
                    {project.name}
                  </span>
                  <span style="color: var(--color-muted)">{project.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="mx-auto w-full max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow mb-1.5">Projects</p>
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
              Featured work
            </h2>
          </div>
          <a
            href="/projects"
            class="link-underline shrink-0 text-sm font-medium text-[color:var(--color-muted)] hover:text-[color:var(--color-text)]"
          >
            View all
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} headingLevel="h3" />
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="border-t border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40">
        <div class="mx-auto w-full max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
          <div class="mb-8 flex items-end justify-between gap-4">
            <div>
              <p class="eyebrow mb-1.5">Writing</p>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                Latest posts
              </h2>
            </div>
            <a
              href="/blog"
              class="link-underline shrink-0 text-sm font-medium text-[color:var(--color-muted)] hover:text-[color:var(--color-text)]"
            >
              All posts
            </a>
          </div>
          <div class="divide-y divide-[color:var(--color-border)]">
            {posts.map((post) => (
              <BlogCard post={post} headingLevel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
