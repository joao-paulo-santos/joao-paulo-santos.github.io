---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  updates: CollectionEntry<'updates'>[];
}

const { updates } = Astro.props;

const sorted = [...updates].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const rendered = await Promise.all(
  sorted.map(async (u) => {
    const { Content } = await render(u);
    return { update: u, Content };
  })
);

const typeLabels = {
  release: 'Release',
  progress: 'Progress',
  breaking: 'Breaking',
  note: 'Note',
};
const typeColors = {
  release: '#22c55e',
  progress: '#3b82f6',
  breaking: '#ef4444',
  note: '#71717a',
};

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

{
  rendered.length === 0 ? (
    <p class="text-sm" style="color: var(--color-muted)">
      No updates yet.
    </p>
  ) : (
    <ol class="space-y-7 border-l border-[color:var(--color-border)] pl-6">
      {rendered.map(({ update, Content }) => (
        <li id={update.id} class="relative scroll-mt-20">
          <span
            class="absolute -left-[1.625rem] top-1.5 h-3 w-3 rounded-full ring-4 ring-[color:var(--color-bg)]"
            style={`background-color: ${typeColors[update.data.type]}`}
          />
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <time
              datetime={update.data.date.toISOString()}
              style="color: var(--color-muted)"
            >
              {dateFmt.format(update.data.date)}
            </time>
            <span
              class="rounded px-1.5 py-0.5 text-xs font-medium"
              style={`background-color: ${typeColors[update.data.type]}22; color: ${typeColors[update.data.type]}`}
            >
              {typeLabels[update.data.type]}
            </span>
          </div>
          <h3 class="mt-1.5 text-base font-semibold">{update.data.title}</h3>
          <div class="prose mt-2 text-sm">
            <Content />
          </div>
        </li>
      ))}
    </ol>
  )
}
