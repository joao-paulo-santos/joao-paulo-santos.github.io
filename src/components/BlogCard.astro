---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const Tag = headingLevel;

function readingTime(body: string | undefined): number {
  if (!body) return 1;
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const minutes = readingTime(post.body);
---

<article
  class="group relative py-5 first:pt-0 last:pb-0"
>
  <div class="flex items-center gap-3 font-mono text-xs"
    style="color: var(--color-subtle)"
  >
    <FormattedDate date={pubDate} />
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </div>

  <Tag class="mt-1.5 text-lg font-semibold tracking-tight sm:text-xl">
    <a
      href={`/blog/${post.id}`}
      class="text-[color:var(--color-text)] transition hover:text-[color:var(--color-accent)]"
    >
      {title}
    </a>
  </Tag>

  <p class="mt-1.5 text-sm" style="color: var(--color-muted)">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-2.5 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li>
            <a
              href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
              class="rounded-md border border-[color:var(--color-border)] px-1.5 py-0.5 font-mono text-[0.7rem] text-[color:var(--color-subtle)] transition hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
