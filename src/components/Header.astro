---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + '/');
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur-md bg-[color:var(--color-bg-elevated)]/95 border-[color:var(--color-border)]"
>
  <div
    class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8"
  >
    <a
      href="/"
      class="link-underline font-semibold tracking-tight text-[color:var(--color-text)]"
      rel="home"
    >
      {SITE_TITLE}
    </a>

    <nav aria-label="Primary" class="flex items-center gap-5">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'link-underline text-sm font-medium transition',
              isActive(link.href)
                ? 'text-[color:var(--color-text)]'
                : 'text-[color:var(--color-muted)] hover:text-[color:var(--color-text)]',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div class="ml-1">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
