---
import { SITE_SHORT_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(href + '/');
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur bg-[color:var(--color-bg)]/80 border-[color:var(--color-border)]"
>
  <div
    class="mx-auto flex h-14 w-full max-w-4xl items-center justify-between px-5"
  >
    <a
      href="/"
      class="font-semibold tracking-tight text-[color:var(--color-text)] hover:text-[color:var(--color-accent)]"
      rel="home"
    >
      {SITE_SHORT_TITLE}
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition',
              isActive(link.href)
                ? 'text-[color:var(--color-accent)]'
                : 'text-[color:var(--color-muted)] hover:text-[color:var(--color-text)]',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div class="ml-2">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
