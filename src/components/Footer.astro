---
import { SITE_TITLE, SOCIALS } from '../consts';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[color:var(--color-border)]">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-3 px-5 py-6 text-sm text-[color:var(--color-muted)] sm:flex-row sm:px-8"
  >
    <p>© {year} {SITE_TITLE}</p>
    <ul class="flex items-center gap-1">
      {
        SOCIALS.map((social) => (
          <li>
            <a
              href={social.href}
              class="inline-flex h-9 w-9 items-center justify-center rounded-md transition hover:bg-[color:var(--color-surface)] hover:text-[color:var(--color-text)]"
              aria-label={social.label}
              title={social.label}
              rel="me noopener"
              target="_blank"
            >
              <SocialIcon name={social.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
