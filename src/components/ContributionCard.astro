---
interface Props {
  name: string;
  href: string;
  description: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { name, href, description, headingLevel = 'h3' } = Astro.props;
const Tag = headingLevel;

// Deterministic accent hue from the project name, matching the treatment
// used on ProjectCard so the two card types feel related.
function hueFor(seed: string): number {
  let h = 0;
  for (let i = 0; i < seed.length; i++) {
    h = ((h << 5) - h + seed.charCodeAt(i)) | 0;
  }
  return Math.abs(h) % 360;
}
const accent = `hsl(${hueFor(name)}, 65%, 55%)`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="group relative flex h-full flex-col gap-2 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-border)] border-l-[3px] bg-[color:var(--color-bg-elevated)] p-4 shadow-[var(--shadow-sm)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-border-strong)] hover:shadow-[var(--shadow)]"
  style={`border-left-color: ${accent};`}
>
  <div class="flex items-start justify-between gap-2">
    <Tag
      class="font-mono text-sm font-semibold tracking-tight text-[color:var(--color-text)] transition group-hover:text-[color:var(--color-accent)]"
    >
      {name}
    </Tag>
    <svg
      class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[color:var(--color-subtle)] opacity-60 transition group-hover:text-[color:var(--color-accent)] group-hover:opacity-100"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>
  <p class="text-xs leading-relaxed" style="color: var(--color-muted)">
    {description}
  </p>
</a>
