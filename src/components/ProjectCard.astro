---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h2' } = Astro.props;
const { name, description, tech, status, pubDate } = project.data;
const Tag = headingLevel;

const statusLabels: Record<typeof status, string> = {
  active: 'Active',
  paused: 'Paused',
  finished: 'Finished',
};
const statusColors: Record<typeof status, string> = {
  active: 'var(--color-success)',
  paused: '#f59e0b',
  finished: 'var(--color-subtle)',
};

// Deterministic accent hue from the project id, so each card gets a stable
// color identity without color-of-the-rainbow chaos.
function hueFor(seed: string): number {
  let h = 0;
  for (let i = 0; i < seed.length; i++) {
    h = ((h << 5) - h + seed.charCodeAt(i)) | 0;
  }
  return Math.abs(h) % 360;
}
const accent = `hsl(${hueFor(project.id)}, 65%, 55%)`;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a
  href={`/projects/${project.id}`}
  class="group relative flex h-full flex-col gap-3 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-border)] border-l-[3px] bg-[color:var(--color-bg-elevated)] p-5 shadow-[var(--shadow-sm)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-border-strong)] hover:shadow-[var(--shadow)]"
  style={`border-left-color: ${accent};`}
>
  <div class="flex items-start justify-between gap-3">
    <Tag
      class="font-semibold tracking-tight text-[color:var(--color-text)] transition group-hover:text-[color:var(--color-accent)]"
    >
      {name}
    </Tag>
    <span
      class="inline-flex shrink-0 items-center gap-1.5 text-xs font-medium"
      style={`color: ${statusColors[status]}`}
    >
      <span
        class="h-1.5 w-1.5 rounded-full"
        style={`background-color: ${statusColors[status]}`}
      ></span>
      {statusLabels[status]}
    </span>
  </div>

  <p class="text-sm" style="color: var(--color-muted)">{description}</p>

  {
    tech.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
        {tech.map((t) => (
          <li class="rounded-md border border-[color:var(--color-border)] px-1.5 py-0.5 font-mono text-[0.7rem] text-[color:var(--color-subtle)]">
            {t}
          </li>
        ))}
      </ul>
    )
  }

  <p class="font-mono text-xs" style="color: var(--color-subtle)">
    {dateFmt.format(pubDate)}
  </p>
</a>
