---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, description, tech, status, pubDate } = project.data;

const statusLabels: Record<typeof status, string> = {
  active: 'Active',
  paused: 'Paused',
  finished: 'Finished',
};
const statusColors: Record<typeof status, string> = {
  active: '#22c55e',
  paused: '#f59e0b',
  finished: '#71717a',
};

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col gap-3 rounded-lg border border-[color:var(--color-border)] p-5 transition hover:border-[color:var(--color-accent)] hover:bg-[color:var(--color-surface)]"
>
  <div class="flex items-start justify-between gap-3">
    <h3
      class="font-semibold text-[color:var(--color-text)] group-hover:text-[color:var(--color-accent)]"
    >
      {name}
    </h3>
    <span
      class="inline-flex shrink-0 items-center gap-1.5 text-xs font-medium"
      style={`color: ${statusColors[status]}`}
    >
      <span
        class="h-1.5 w-1.5 rounded-full"
        style={`background-color: ${statusColors[status]}`}
      ></span>
      {statusLabels[status]}
    </span>
  </div>

  <p class="text-sm" style="color: var(--color-muted)">{description}</p>

  {
    tech.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
        {tech.map((t) => (
          <li class="rounded border border-[color:var(--color-border)] px-1.5 py-0.5 text-xs text-[color:var(--color-muted)]">
            {t}
          </li>
        ))}
      </ul>
    )
  }

  <p class="text-xs" style="color: var(--color-muted)">
    {dateFmt.format(pubDate)}
  </p>
</a>
